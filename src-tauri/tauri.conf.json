{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ReqX",
  "version": "0.2.2",
  "identifier": "com.postmanclone.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "ReqX",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU2Mjc3N0I5RTlEOTYwNzkKUldSNVlObnB1WGNuVnVWWEhtR3o4dkhickh3YlhaTmlxcmpsZE43NGlFMmw1SnozMUlhZDc3R3YK",
      "endpoints": [
        "https://github.com/lgponlylove/reqX-releases/releases/latest/download/latest.json",
        "https://github.com/lgponlylove/reqX/releases/latest/download/latest.json"
      ]
    }
  }
}
